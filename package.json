{
  "name": "rag-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "Handbook RAG chatbot with a retrieval + LLM-judge eval harness",
  "scripts": {
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "retrieve": "tsx --env-file=.env.local scripts/try-retrieve.ts",
    "ask": "tsx --env-file=.env.local scripts/try-answer.ts",
    "judge:test": "tsx --env-file=.env.local scripts/try-judge.ts",
    "models": "tsx --env-file=.env.local scripts/list-models.ts",
    "evals": "tsx --env-file=.env.local scripts/run-evals.ts",
    "typecheck": "tsc --noEmit",
    "test:tools": "tsx scripts/test-tools.ts",
    "evals:tools": "tsx --env-file=.env.local scripts/run-tool-evals.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
